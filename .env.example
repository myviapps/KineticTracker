# Supabase — get these from your Supabase project dashboard
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cron — any strong random string; used to authenticate the periodic refresh endpoint
CRON_SECRET="generate-a-strong-random-secret"

# Vite-prefixed variants (injected into client bundle)
VITE_SUPABASE_URL="${SUPABASE_URL}"
VITE_SUPABASE_PUBLISHABLE_KEY="${SUPABASE_PUBLISHABLE_KEY}"

# Absolute origin for the marketing page's canonical and og:image URLs
# (social scrapers reject relative URLs). Leave unset for local dev.
VITE_SITE_URL="https://almanac.example.com"

# Render sidecar (scraper-service/) — a small Python service that returns the
# HTML a real browser would have seen. Required by hackerearth, interviewbit,
# code360 and spoj; every other platform ignores it.
# Empty URL = disabled, and those four report "needs browser rendering".
SCRAPLING_URL=""
SCRAPLING_TOKEN="must match SCRAPLING_TOKEN in scraper-service/.env"
