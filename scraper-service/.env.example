# ─── Set on THIS service ──────────────────────────────────────────────────────

# Shared secret. The service rejects any request whose Authorization header is
# not exactly `Bearer <this>`. Leave empty ONLY for local development — an
# unauthenticated renderer on a public IP is an open proxy.
# Must be byte-identical to SCRAPLING_TOKEN in the Kenitic Tracker Hub app.
#   generate with:  openssl rand -hex 32
SCRAPLING_TOKEN=

# Port uvicorn binds. Fly/Railway inject this themselves.
PORT=8000

LOG_LEVEL=INFO

# ─── Browser lifecycle (see the header comment in main.py) ────────────────────

# Concurrent tabs inside each browser process. Raising this is the fastest way
# to run a small box out of memory: budget ~150MB per tab on top of ~250MB base.
SCRAPLING_MAX_PAGES=2

# Requests admitted concurrently. Defaults to SCRAPLING_MAX_PAGES. Do not set it
# higher — the surplus would queue inside Scrapling's page pool, which waits a
# full 60s before giving up, blowing every caller's deadline at once.
SCRAPLING_MAX_CONCURRENCY=2

# Navigations before a browser process is retired and relaunched. Bounds
# Chromium's memory drift over long uptimes.
SCRAPLING_SESSION_MAX_USES=60

# ─── Timeouts (ms) ────────────────────────────────────────────────────────────
# The client (src/lib/platforms/render.ts) aborts at 30s normally and 60s when
# solving Cloudflare. Every value below must stay under those, or the client
# gives up on a socket that is still working.

SCRAPLING_TIMEOUT_MS=20000        # in-page timeout, normal path
SCRAPLING_CF_TIMEOUT_MS=45000     # in-page timeout, Cloudflare path (Scrapling
                                  # floors this at 60000 internally — the hard
                                  # timeout below is what actually binds)
SCRAPLING_HARD_TIMEOUT_MS=26000   # outer wall, normal path
SCRAPLING_CF_HARD_TIMEOUT_MS=55000# outer wall, Cloudflare path
SCRAPLING_MAX_SETTLE_MS=10000     # ceiling on the caller's settle_ms

# ─── Tuning ───────────────────────────────────────────────────────────────────

# Drop fonts/images/media/stylesheets/websockets on the non-Cloudflare path.
# Big memory win. Turn OFF first if a platform's HTML starts parsing wrong.
SCRAPLING_BLOCK_RESOURCES=true

# Chromium crashes on the default 64MB container /dev/shm. Clear this only if
# you run the container with --shm-size=1g.
SCRAPLING_EXTRA_FLAGS=--disable-dev-shm-usage

SCRAPLING_HEADLESS=true

# ─── Set on the Kenitic Tracker Hub app, NOT here ─────────────────────────────
# SCRAPLING_URL=https://your-scraper.fly.dev
# SCRAPLING_TOKEN=<the same value as above>
